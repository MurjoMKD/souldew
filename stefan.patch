diff --git a/web/views/archeats.mjs b/web/views/archeats.mjs
new file mode 100644
index 0000000..c19d505
--- /dev/null
+++ b/web/views/archeats.mjs
@@ -0,0 +1,170 @@
+// Action Replay codes in the game screen's cheat menu: a list per game, each code with its own switch. Switched-on codes
+// run a few times per second (shared/live/arcodes.mjs) – like a real Action Replay, but the switch is the activator
+// (no "press SELECT"). Codes are kept per game (the ROM's game code) in this computer's storage.
+import { html, useState, useEffect, useRef } from '/vendor/htm-preact.mjs';
+import { Icon } from '../lib/icons.mjs';
+import { t } from '../lib/i18n.mjs';
+import { parseAR, formatAR, runAR } from '/shared/live/arcodes.mjs';
+
+// Codes that come with souldew for a game (game code prefix → codes). Black 2: tested by Stefan on the German
+// European version (IRED). The "Pokémon" slot is left empty to fill in.
+const PRESETS = [
+  {
+    match: /^IRE/, // Pokémon Black 2 (all languages – tested on the German one)
+    codes: [
+      { id: 'b2-happy', name: 'Max Freundschaft', note: 'Getestet (Schwarz 2 EU)', code: '5201E65C BDF873B4\n0201E65C FAD0F7E3\nD0000000 00000000\n02001C00 73B4B4FF\n02001FFC BDF8BCFF\n02001CAC 733020FF' },
+      { id: 'b2-repel', name: 'Max Repel (255 Schritte)', note: 'Getestet (Schwarz 2 EU)', code: '94000130 FFFB0000\nB2000024 00000000\n2002224D 000000FF\nD2000000 00000000' },
+      { id: 'b2-candy', name: 'Unendlich Sonderbonbon', note: 'Getestet (Schwarz 2 EU)', code: '94000130 FFFB0000\nB2000024 00000000\n000194F8 FFFF0032\nD2000000 00000000' },
+      { id: 'b2-bp', name: 'Battle Points (9999)', note: 'Getestet (Schwarz 2 EU)', code: '94000130 FFFB0000\nB2000024 00000000\n10022420 0000270F\nD2000000 00000000' },
+      { id: 'b2-catch', name: '100 % Fangrate', note: 'Noch ungetestet', code: '521AF790 7820D203\n121AF790 000046C0\nD2000000 00000000' },
+      { id: 'b2-pokemon', name: 'Pokémon', note: 'Euren Code hier einfügen', code: '' },
+    ],
+  },
+];
+
+const storeKey = (game) => `sl-ar-${game}`;
+function load(game) {
+  try {
+    const v = JSON.parse(localStorage.getItem(storeKey(game)) || 'null');
+    if (v && Array.isArray(v.items)) return v.items;
+  } catch {
+    // broken entry: start over
+  }
+  const preset = PRESETS.find((p) => p.match.test(game));
+  return preset ? preset.codes.map((c) => ({ ...c, on: false })) : [];
+}
+function save(game, items) {
+  try {
+    localStorage.setItem(storeKey(game), JSON.stringify({ items }));
+  } catch {
+    // private mode
+  }
+}
+
+/** The ROM's game code ("IRED") from the header copy in main RAM, or null while the game isn't up yet. */
+function readGameCode(e) {
+  try {
+    const b = e?.read?.(0x023ffe0c, 4);
+    if (!b || b.length < 4) return null;
+    const s = String.fromCharCode(b[0], b[1], b[2], b[3]);
+    return /^[A-Z0-9]{4}$/.test(s) ? s : null;
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * The codes of the running game and the loop that runs the switched-on ones.
+ * `emu`: () => the player's API ({ read, write }); `active`: may codes run right now (game running, rules allow it).
+ */
+export function useARCheats({ emu, fallbackKey, active, enabled }) {
+  const [game, setGame] = useState(null);
+  const [items, setItemsState] = useState([]);
+  // the game code: read once the game is up (the header copy is in main RAM), the run's / library's code until then
+  useEffect(() => {
+    if (!enabled) return undefined;
+    let done = false;
+    const id = setInterval(() => {
+      if (done) return;
+      const c = readGameCode(emu());
+      if (c) {
+        done = true;
+        setGame(c);
+      }
+    }, 1000);
+    return () => clearInterval(id);
+  }, [enabled]);
+  const key = game || fallbackKey || null;
+  useEffect(() => { if (key) setItemsState(load(key)); }, [key]);
+  const setItems = (next) => {
+    setItemsState(next);
+    if (key) save(key, next);
+  };
+
+  const ref = useRef({});
+  ref.current = { items, active };
+  const cache = useRef(new Map()); // code text → parsed lines
+  useEffect(() => {
+    if (!enabled) return undefined;
+    const id = setInterval(() => {
+      const { items: list, active: on } = ref.current;
+      if (!on || !list.some((c) => c.on)) return;
+      const e = emu();
+      if (!e?.read || !e?.write) return;
+      const mem = { read: e.read, write: e.write };
+      for (const c of list) {
+        if (!c.on) continue;
+        let p = cache.current.get(c.code);
+        if (!p) cache.current.set(c.code, (p = parseAR(c.code)));
+        if (!p.ok) continue;
+        try {
+          runAR(p.lines, mem);
+        } catch {
+          // a code that throws is skipped this time
+        }
+      }
+    }, 100);
+    return () => clearInterval(id);
+  }, [enabled]);
+  return { key, items, setItems };
+}
+
+const newId = () => `c-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 6)}`;
+const errText = (p) => (p.error === 'empty' ? t('ar.errEmpty', 'Enter a code first.')
+  : p.error === 'odd' ? t('ar.errOdd', 'Every line needs two 8-digit blocks.')
+    : t('ar.errWord', '“{w}” isn’t an 8-digit hex block.', { w: p.at }));
+
+/** The list with switches, plus adding / editing / deleting codes. */
+export function ARCheatList({ cheats, why, onToggled }) {
+  const { items, setItems, key } = cheats;
+  const [edit, setEdit] = useState(null); // { id|null, name, code, error }
+  if (!key) return html`<span class="tiny faint">${t('ar.waitGame', 'Codes show up once the game is running.')}</span>`;
+
+  const toggle = (c) => {
+    if (!c.on && !parseAR(c.code).ok) return setEdit({ id: c.id, name: c.name, code: c.code, error: null });
+    setItems(items.map((x) => (x.id === c.id ? { ...x, on: !x.on } : x)));
+    onToggled?.(c, !c.on);
+  };
+  const store = () => {
+    const p = parseAR(edit.code);
+    if (!p.ok) return setEdit({ ...edit, error: errText(p) });
+    const name = edit.name.trim() || t('ar.unnamed', 'Code');
+    const code = formatAR(edit.code);
+    setItems(edit.id ? items.map((x) => (x.id === edit.id ? { ...x, name, code } : x)) : [...items, { id: newId(), name, code, on: false }]);
+    setEdit(null);
+  };
+  const del = (c) => setItems(items.filter((x) => x.id !== c.id));
+
+  if (edit) {
+    return html`<div class="ar-edit">
+      <label class="tiny faint">${t('ar.name', 'Name')}</label>
+      <input type="text" value=${edit.name} placeholder=${t('ar.namePh', 'e.g. Max Repel')} onInput=${(e) => setEdit({ ...edit, name: e.target.value })} />
