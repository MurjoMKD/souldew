+        <span class="grow ar-name">
+          <span class="small">${c.name}</span>
+          ${(!ok || c.note) && html`<span class="tiny faint">${!ok ? t('ar.empty', 'No code yet – click ✎ to add it') : c.note}</span>`}
+        </span>
+        <button class="btn icon ghost ar-mini" title=${t('ar.edit', 'Edit')} onClick=${() => setEdit({ id: c.id, name: c.name, code: c.code, error: null })}>✎</button>
+        <button class="btn icon ghost ar-mini" title=${t('ar.delete', 'Delete')} onClick=${() => del(c)}><${Icon} name="close" size=${12} /></button>
+      </div>`;
+    })}
+    <button class="btn small ghost" onClick=${() => setEdit({ id: null, name: '', code: '', error: null })}>+ ${t('ar.add', 'Add code')}</button>
+    ${why && html`<span class="tiny faint">${why}</span>`}
+  </div>`;
+}
