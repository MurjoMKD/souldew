diff --git a/shared/live/arcodes.mjs b/shared/live/arcodes.mjs
new file mode 100644
index 0000000..f877cbf
--- /dev/null
+++ b/shared/live/arcodes.mjs
@@ -0,0 +1,177 @@
+// Action Replay DS codes – the same codes people type into DeSmuME or melonDS, run by souldew itself.
+//
+// Why not the core's own cheat support: the fast player (native host) has none, and the browser cores differ in what
+// they accept. Like shared/live/cheats.mjs this works on any memory source with read(addr, len) / write(addr, bytes)
+// on console bus addresses – both DS players mirror the whole main RAM (0x02000000, 4 MB). souldew runs every switched
+// on code a few times per second, which is what a real Action Replay does too (once per frame).
+//
+// Supported: the usual Action Replay DS code types (EnHacklopedia "Action Replay DS" / melonDS AREngine):
+//   0/1/2  write 32/16/8 bit            3–6  32-bit conditions      7–A  16-bit masked conditions
+//   B      offset = [addr + offset]     C0   loop                   D0/D1/D2 end-if / next / end-all
+//   D3–DC  offset and data register     E    patch bytes            F    copy bytes
+// Only main RAM is read or written. Conditions on the buttons (0x04000130 / 0x027FFFA8 – "press L+R") always count
+// as true: in souldew the switch is the activator.
+
+const RAM_BASE = 0x02000000;
+const RAM_MASK = 0x3fffff; // 4 MB, mirrored up to 0x02FFFFFF
+const KEY_ADDRS = new Set([0x04000130, 0x04000136, 0x027fffa8, 0x023fffa8]);
+
+/** A main-RAM bus address for `a` (mirrors folded in), or -1 outside main RAM. */
+export const ramAddr = (a) => ((a >>> 24) === 2 ? RAM_BASE + (a & RAM_MASK) : -1);
+
+/**
+ * Parse an Action Replay code: lines of two 8-digit hex words ("12345678 9ABCDEF0"), separated by spaces, new lines or
+ * "+" (RetroArch's style). Returns { ok, lines: [[a, b], …] } or { ok: false, error, at } with the bad word.
+ */
+export function parseAR(text) {
+  const words = String(text || '').replace(/[:;,]/g, ' ').split(/[\s+]+/).filter(Boolean);
+  if (!words.length) return { ok: false, error: 'empty' };
+  for (const w of words) if (!/^[0-9a-f]{8}$/i.test(w)) return { ok: false, error: 'word', at: w };
+  if (words.length % 2) return { ok: false, error: 'odd' };
+  const lines = [];
+  for (let i = 0; i < words.length; i += 2) lines.push([parseInt(words[i], 16) >>> 0, parseInt(words[i + 1], 16) >>> 0]);
+  return { ok: true, lines };
+}
+
+/** The code tidied up: one "XXXXXXXX YYYYYYYY" line per instruction (upper case) – or the text as it was if it doesn't parse. */
+export function formatAR(text) {
+  const p = parseAR(text);
+  if (!p.ok) return String(text || '').trim();
+  const h = (v) => v.toString(16).toUpperCase().padStart(8, '0');
+  return p.lines.map(([a, b]) => `${h(a)} ${h(b)}`).join('\n');
+}
+
+const MAX_STEPS = 100000; // loops can't hang the page
+
+/**
+ * Run parsed code lines once against `mem` ({ read, write }). Writes only where the value differs (fewer messages to the
+ * native host). Returns { writes, skipped } – `skipped`: instructions that touched memory outside main RAM.
+ */
+export function runAR(lines, mem) {
+  let offset = 0;
+  let data = 0;
+  let cond = true;
+  const stack = [];
+  let loop = null; // { start, count }
+  let writes = 0;
+  let skipped = 0;
+  let steps = 0;
+
+  const rd = (addr, n) => {
+    const a = ramAddr(addr >>> 0);
+    if (a < 0) return null;
+    const b = mem.read(a, n);
+    if (!b || b.length < n) return null;
+    let v = 0;
+    for (let i = n - 1; i >= 0; i--) v = (v * 256) + b[i];
+    return v >>> 0;
+  };
+  const wrBytes = (addr, bytes) => {
+    const a = ramAddr(addr >>> 0);
+    if (a < 0 || ramAddr((addr + bytes.length - 1) >>> 0) < 0) { skipped++; return; }
+    const cur = mem.read(a, bytes.length);
+    if (cur && cur.length === bytes.length && cur.every((x, i) => x === bytes[i])) return;
+    if (mem.write(a, bytes) !== false) writes++;
+  };
+  const wr = (addr, v, n) => {
+    const b = new Uint8Array(n);
+    for (let i = 0; i < n; i++) b[i] = (v >>> (8 * i)) & 0xff;
+    wrBytes(addr, b);
+  };
+  const push = (test) => { stack.push(cond); cond = cond && test; };
+  // address of a condition: 0 in the code means "the offset"
+  const condAddr = (a) => (a & 0x0fffffff) || offset;
+
+  for (let i = 0; i < lines.length; i++) {
+    if (++steps > MAX_STEPS) break;
+    const [a, b] = lines[i];
+    const op = a >>> 28;
+    const addr = (a & 0x0fffffff) + offset;
+    if (op <= 2) {
+      if (cond) wr(addr, b, op === 0 ? 4 : op === 1 ? 2 : 1);
+      continue;
+    }
+    if (op >= 3 && op <= 6) {
+      const ca = condAddr(a);
+      if (KEY_ADDRS.has(ca >>> 0)) { push(true); continue; }
+      const v = rd(ca, 4);
+      push(v != null && (op === 3 ? b > v : op === 4 ? b < v : op === 5 ? b === v : b !== v));
+      continue;
+    }
+    if (op >= 7 && op <= 0xa) {
+      const ca = condAddr(a);
+      if (KEY_ADDRS.has(ca >>> 0)) { push(true); continue; }
+      const raw = rd(ca, 2);
+      const mask = (~(b >>> 16)) & 0xffff;
+      const want = b & 0xffff;
+      const v = raw == null ? null : raw & mask;
+      push(v != null && (op === 7 ? want > v : op === 8 ? want < v : op === 9 ? want === v : want !== v));
+      continue;
+    }
+    if (op === 0xb) {
+      if (cond) { const v = rd(addr, 4); offset = v ?? 0; if (v == null) cond = false; }
+      continue;
+    }
+    if (op === 0xc) {
+      const sub = (a >>> 24) & 0xf;
+      if (sub === 0) loop = { start: i, count: b };
+      else if (sub === 6 && cond) wr(b, offset, 4); // C6: store the offset
+      continue;
+    }
+    if (op === 0xd) {
+      const sub = (a >>> 24) & 0xf;
+      switch (sub) {
+        case 0: cond = stack.length ? stack.pop() : true; break; // end-if
+        case 1: // next (loop), conditions stay
+          if (loop && loop.count > 0) { loop.count--; i = loop.start; } else loop = null;
+          break;
+        case 2: // next and end everything
+          if (loop && loop.count > 0) { loop.count--; i = loop.start; } else { loop = null; offset = 0; data = 0; cond = true; stack.length = 0; }
+          break;
+        case 3: if (cond) offset = b; break;
+        case 4: if (cond) data = (data + b) >>> 0; break;
+        case 5: if (cond) data = b; break;
+        case 6: if (cond) { wr(b + offset, data, 4); offset += 4; } break;
+        case 7: if (cond) { wr(b + offset, data & 0xffff, 2); offset += 2; } break;
+        case 8: if (cond) { wr(b + offset, data & 0xff, 1); offset += 1; } break;
+        case 9: if (cond) data = rd(b + offset, 4) ?? 0; break;
+        case 0xa: if (cond) data = rd(b + offset, 2) ?? 0; break;
+        case 0xb: if (cond) data = rd(b + offset, 1) ?? 0; break;
+        case 0xc: if (cond) offset = (offset + b) >>> 0; break;
+        default: break;
+      }
+      offset >>>= 0;
+      continue;
+    }
+    if (op === 0xe) {
+      // E: `b` bytes follow, 8 per line
+      const n = b;
+      const nLines = Math.ceil(n / 8);
+      if (cond) {
+        const bytes = new Uint8Array(n);
+        for (let k = 0; k < n; k++) {
+          const line = lines[i + 1 + (k >> 3)];
+          if (!line) break;
+          const word = line[(k >> 2) & 1];
+          bytes[k] = (word >>> (8 * (k & 3))) & 0xff;
+        }
+        if (n) wrBytes(addr, bytes);
+      }
+      i += nLines;
+      continue;
+    }
+    if (op === 0xf) {
+      if (cond && b > 0 && b <= 0x10000) {
+        const src = ramAddr(offset >>> 0);
+        const got = src >= 0 ? mem.read(src, b) : null;
+        if (got && got.length === b) wrBytes(a & 0x0fffffff, got);
+        else skipped++;
+      }
+      continue;
+    }
+  }
+  return { writes, skipped };
+}
+
+/** Is this cheat code valid for souldew (parses, and isn't empty)? */
+export const validAR = (text) => parseAR(text).ok;
diff --git a/test/arcodes.test.mjs b/test/arcodes.test.mjs
new file mode 100644
index 0000000..c415e5b
--- /dev/null
+++ b/test/arcodes.test.mjs
@@ -0,0 +1,95 @@
+// Action Replay DS codes (shared/live/arcodes.mjs): parsing and the code types on a synthetic main RAM.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { parseAR, formatAR, runAR, ramAddr, validAR } from '../shared/live/arcodes.mjs';
+
+/** 4 MB main RAM at 0x02000000, like both DS players' read/write. */
+function ram() {
+  const b = new Uint8Array(0x400000);
+  const m = {
+    b,
+    writes: [],
+    read(a, n) { const o = a - 0x02000000; return o < 0 || o + n > b.length ? null : b.slice(o, o + n); },
+    write(a, bytes) { const o = a - 0x02000000; if (o < 0 || o + bytes.length > b.length) return false; b.set(bytes, o); m.writes.push(a); return true; },
+    u32(a) { const o = a - 0x02000000; return (b[o] | (b[o + 1] << 8) | (b[o + 2] << 16) | (b[o + 3] << 24)) >>> 0; },
+    set32(a, v) { const o = a - 0x02000000; for (let i = 0; i < 4; i++) b[o + i] = (v >>> (8 * i)) & 0xff; },
+  };
+  return m;
+}
+const run = (code, m) => runAR(parseAR(code).lines, m);
+
+test('parse: spaces, new lines and "+" all separate; bad input is named', () => {
+  assert.deepEqual(parseAR('02000000 00000063\n12000004 0000FFFF').lines, [[0x02000000, 0x63], [0x12000004, 0xffff]]);
+  assert.deepEqual(parseAR('02000000 00000063+12000004 0000FFFF').lines.length, 2);
+  assert.equal(parseAR('0200000 00000063').error, 'word');
+  assert.equal(parseAR('02000000').error, 'odd');
+  assert.equal(parseAR('  ').error, 'empty');
+  assert.equal(formatAR('02000000 63000000+b2000024 00000000'), '02000000 63000000\nB2000024 00000000');
+  assert.ok(validAR('D2000000 00000000'));
+});
+
+test('main RAM only, mirrors folded in', () => {
+  assert.equal(ramAddr(0x027ffe0c), 0x023ffe0c);
+  assert.equal(ramAddr(0x04000130), -1);
+});
+
+test('0/1/2 write 32/16/8 bit, only when the value differs', () => {
+  const m = ram();
+  run('02000010 12345678\n12000020 0000BEEF\n22000030 000000AA', m);
+  assert.equal(m.u32(0x02000010), 0x12345678);
+  assert.equal(m.u32(0x02000020), 0xbeef);
+  assert.equal(m.b[0x30], 0xaa);
+  assert.equal(m.writes.length, 3);
+  run('02000010 12345678', m);
+  assert.equal(m.writes.length, 3, 'same value: no second write');
+});
+
+test('B pointer + D2: the typical Pokémon code', () => {
+  const m = ram();
+  m.set32(0x02000024, 0x02210000); // the pointer the game keeps
+  run('B2000024 00000000\n10000100 000003E7\nD2000000 00000000\n02000040 00000001', m);
+  assert.equal(m.u32(0x02210100) & 0xffff, 999);
+  assert.equal(m.u32(0x02000040), 1, 'D2 reset the offset');
+});
+
+test('conditions and end-if', () => {
+  const m = ram();
+  m.set32(0x02000000, 5);
+  run('52000000 00000005\n02000010 00000001\nD0000000 00000000\n52000000 00000006\n02000014 00000001\nD0000000 00000000\n02000018 00000001', m);
+  assert.equal(m.u32(0x02000010), 1, 'equal: runs');
+  assert.equal(m.u32(0x02000014), 0, 'not equal: skipped');
+  assert.equal(m.u32(0x02000018), 1, 'after D0: runs again');
+  // 16-bit masked: upper half is the mask of bits to ignore
+  m.set32(0x02000004, 0x1234);
+  run('92000004 FF000034\n02000020 00000001\nD2000000 00000000', m);
+  assert.equal(m.u32(0x02000020), 1);
+});
+
+test('button conditions count as pressed', () => {
+  const m = ram();
+  run('94000130 FCFF0000\n02000010 00000007\nD2000000 00000000', m);
+  assert.equal(m.u32(0x02000010), 7);
+});
+
+test('loops with the data register, E patch and F copy', () => {
+  const m = ram();
+  run('D3000000 02000100\nC0000000 00000003\nD5000000 00000063\nD6000000 00000000\nD2000000 00000000', m);
+  for (let i = 0; i < 4; i++) assert.equal(m.u32(0x02000100 + i * 4), 0x63, `slot ${i}`);
+  run('E2000200 00000006\n44332211 00006655', m);
+  assert.deepEqual([...m.b.slice(0x200, 0x206)], [0x11, 0x22, 0x33, 0x44, 0x55, 0x66]);
+  run('D3000000 02000200\nF2000300 00000006\nD2000000 00000000', m);
+  assert.deepEqual([...m.b.slice(0x300, 0x306)], [0x11, 0x22, 0x33, 0x44, 0x55, 0x66]);
+});
+
+test('nothing outside main RAM is written', () => {
+  const m = ram();
+  const r = run('04000000 00000001', m);
+  assert.equal(r.skipped, 1);
+  assert.equal(m.writes.length, 0);
+});
+
+test('an endless loop stops', () => {
+  const m = ram();
+  run('C0000000 FFFFFFFF\nD1000000 00000000', m);
+  assert.ok(true);
+});
