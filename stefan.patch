diff --git a/web/views/rompicker.mjs b/web/views/rompicker.mjs
new file mode 100644
index 0000000..bfc19bc
--- /dev/null
+++ b/web/views/rompicker.mjs
@@ -0,0 +1,63 @@
+// Stefan Mario SoulLink: picking the ROM for a run – already randomized ROMs, often many of the same game. Used by the
+// new-run page, the join page and "Switch ROM" (web/views/restart.mjs).
+import { html, useState } from '/vendor/htm-preact.mjs';
+import { useApp } from '../lib/ui.mjs';
+import { Icon } from '../lib/icons.mjs';
+import { t } from '../lib/i18n.mjs';
+import { api } from '../lib/api.mjs';
+
+const norm = (n) => String(n || '').split(/[\\/]/).pop().replace(/\.(nds|gba|gbc|gb|3ds|cci|cxi|zip|7z)$/i, '').trim().toLowerCase();
+/** Is library ROM `r` the file named `name` (with or without its extension)? */
+export const sameRomName = (r, name) => !!name && !!r && norm(r.name || r.id) === norm(name);
+
+/**
+ * This build: pick the ROM for a run – already randomized ROMs, often many of the same game. Listed by file name (the
+ * game's title is the same for all of them), with a search field and buttons that add a ROM file or a whole folder of
+ * ROMs straight from here.
+ */
+export function RomPicker({ roms, value, onPick, disabled, label }) {
+  const { library, reloadLibrary, toast } = useApp();
+  const [q, setQ] = useState('');
+  const [adding, setAdding] = useState(false);
+  const words = q.toLowerCase().split(/\s+/).filter(Boolean);
+  const nameOf = (r) => String(r.name || r.title || r.id);
+  const list = [...(roms || [])].filter((r) => words.every((w) => nameOf(r).toLowerCase().includes(w)))
+    .sort((a, b) => nameOf(a).localeCompare(nameOf(b), undefined, { numeric: true }));
+  const add = async (folder) => {
+    if (!window.sls?.pickFiles) return toast?.({ kind: 'death', title: t('sm.noDesktop', 'Only in the desktop app'), text: '' });
+    const paths = await window.sls.pickFiles({ folder, title: folder ? t('sm.pickFolder', 'Choose the folder with your ROMs') : t('sm.pickRom', 'Choose a ROM') });
+    if (!paths?.length) return;
+    setAdding(true);
+    try {
+      const had = new Set((library?.roms || []).map((r) => r.id));
+      if (folder) await api.post('/api/library/folders', { add: paths[0] });
+      else await api.post('/api/library/import', { paths });
+      const after = await reloadLibrary();
+      const fresh = (after?.roms || []).filter((r) => !had.has(r.id));
+      const base = String(paths[0]).split(/[\\/]/).pop().replace(/\.[^.]+$/, '').toLowerCase();
+      const pick = folder ? null : fresh[0] || (after?.roms || []).find((r) => String(r.name || '').toLowerCase() === base);
+      if (pick) onPick(pick.id);
+      toast?.({ kind: 'ok', title: folder ? t('sm.folderAdded', '{n} ROMs added', { n: fresh.length }) : t('sm.romAdded', 'ROM added'), text: pick ? nameOf(pick) : '' });
+    } catch (e) {
+      toast?.({ kind: 'death', title: t('sm.addFailed', 'Could not add the ROM'), text: e.message });
+    }
+    setAdding(false);
+  };
+  return html`<div class="stack-s rom-picker">
+    ${label && html`<span class="small muted">${label}</span>`}
+    <div class="row" style="gap:8px;flex-wrap:wrap">
+      <button class="btn primary" disabled=${disabled || adding} onClick=${() => add(false)}><${Icon} name="plus" size=${16} />${t('sm.addRom', 'Add ROM file')}</button>
+      <button class="btn ghost" disabled=${disabled || adding} onClick=${() => add(true)}><${Icon} name="folder" size=${16} />${t('sm.addFolder', 'Add a whole ROM folder')}</button>
+      ${adding && html`<span class="small muted">${t('sm.adding', 'Adding …')}</span>`}
+    </div>
+    ${(roms || []).length > 0 ? html`
+      <input type="search" value=${q} placeholder=${t('sm.search', 'Search ROMs ({n})', { n: (roms || []).length })} onInput=${(e) => setQ(e.target.value)} />
+      <select class="rom-list" size=${Math.min(10, Math.max(3, list.length))} value=${value} disabled=${disabled} onChange=${(e) => onPick(e.target.value)}>
+        ${list.map((r) => html`<option value=${r.id} selected=${r.id === value}>${nameOf(r)}</option>`)}
+      </select>
+      ${list.length === 0 && html`<span class="small muted">${t('sm.noMatch', 'No ROM matches the search.')}</span>`}
+      ${value && html`<span class="small"><span class="chip ok">${t('sm.chosen', 'Chosen')}</span> <span class="mono">${nameOf((roms || []).find((r) => r.id === value) || {})}</span></span>`}`
+      : html`<p class="small muted">${t('sm.noRoms', 'No ROM in your library yet – add one with the button above.')}</p>`}
+  </div>`;
+}
+
